function respond(body: unknown, status = 200) {
  return new Response(JSON.stringify(body), {
    status,
    headers: corsHeaders,
  });
}

function asObject(value: unknown): Record<string, any> {
  return value && typeof value === "object" && !Array.isArray(value)
    ? value as Record<string, any>
    : {};
}

function firstNonEmpty(...values: unknown[]): any {
  return values.find(
    (v) => v !== undefined && v !== null && String(v).trim() !== "",
  );
}

function errorMessage(value: unknown): string {
  if (value instanceof Error) return value.message;
  if (typeof value === "string") return value;

  try {
    return JSON.stringify(value);
  } catch {
    return "Unknown error";
  }
}

function numberValue(value: unknown): number {
  if (typeof value === "number") {
    return Number.isFinite(value) ? value : NaN;
  }

  if (typeof value === "string") {
    const cleaned = value
      .replace(/₦|NGN/gi, "")
      .replace(/,/g, "")
      .replace(/\s/g, "")
      .trim();

    const n = Number(cleaned);
    return cleaned && Number.isFinite(n) ? n : NaN;
  }

  if (value && typeof value === "object") {
    const o = value as Record<string, unknown>;
    return numberValue(
      firstNonEmpty(o.amount, o.value, o.price, o.selling_price),
    );
  }

  return NaN;
}

function money(value: number): number {
  return Math.round((value + Number.EPSILON) * 100) / 100;
}

function normalizePhone(value: unknown): string {
  return String(value ?? "").replace(/\s+/g, "").replace(/^\+234/, "0");
}

function normalizeProvider(value: unknown): string {
  const raw = String(value ?? "").trim();
  const upper = raw.toUpperCase();

  return PROVIDERS[upper] || raw.toLowerCase().replace(/\s+/g, "");
}

/* ---------------- DYNAMIC PRICING ---------------- */

async function getPricingSettings(): Promise<PricingSettings> {
  const { data, error } = await admin
    .from("panbill_service_pricing")
    .select("settings")
    .eq("id", "default")
    .single();

  if (error || !data?.settings) {
    console.error("Pricing settings could not be loaded:", error);
    throw new Error(
      "PanBill pricing settings could not be loaded. Please contact support.",
    );
  }

  const saved = asObject(data.settings);
  const pricing: Record<string, number> = {};

  for (const key of Object.keys(DEFAULT_PRICING)) {
    const value = Number(saved[key]);

    if (!Number.isFinite(value) || value < 0) {
      throw new Error(`Invalid pricing setting: ${key}`);
    }

    if (value > 10000) {
      throw new Error(`Pricing setting exceeds the allowed limit: ${key}`);
    }

    pricing[key] = value;
  }

  if (pricing.wallet_funding_fee_percent > 10) {
    throw new Error("Wallet funding percentage cannot exceed 10%.");
  }

  return pricing as PricingSettings;
}

/* ---------------- PRODUCT AND PRICE CALCULATIONS ---------------- */

function dataSizeGB(product: any): number {
  const p = asObject(product);

  const candidates = [
    p.data_size,
    p.volume,
    p.size,
    p.data_amount,
    p.allowance,
    p.package_name,
    p.product_name,
    p.name,
    p.description,
    p.title,
    p.package_code,
    p.code,
    p.sku,
  ];

  for (const value of candidates) {
    if (value === undefined || value === null) continue;

    const text = String(value);
    const matches = [
      ...text.matchAll(/(\d+(?:\.\d+)?)\s*(GB|G\b|MB|M\b)/gi),
    ];

    if (!matches.length) continue;

    for (const match of matches) {
      const amount = Number(match[1]);
      const unit = match[2].toLowerCase();

      if (!Number.isFinite(amount)) continue;

      if (unit === "gb" || unit === "g") return amount;
      if (unit === "mb" || unit === "m") return amount / 1024;
    }
  }

  return 0;
}

/*
 * Returns the net adjustment for one unit.
 * Airtime fee and discount are both editable in the admin dashboard.
 */
function serviceFee(
  providerPrice: number,
  service: string,
  product: any,
  pricing: PricingSettings,
): number {
  if (service === "AIRTIME") {
    return pricing.airtime_fee - pricing.airtime_discount;
  }

  if (service === "DATA") {
    return dataSizeGB(product) > 1.5
      ? pricing.data_above_1_5gb_fee
      : 0;
  }

  if (service === "CABLE_TV") {
    const provider = normalizeProvider(
      firstNonEmpty(
        product?.provider_code,
        product?.network,
        product?.provider,
        "",
      ),
    );

    if (provider === "dstv") {
      return providerPrice > 1000000
        ? pricing.dstv_above_1000000_fee
        : pricing.dstv_fee;
    }

    if (provider === "gotv") return pricing.gotv_fee;

    if (provider === "startimes" && providerPrice > 1000) {
      return pricing.startimes_above_1000_fee;
    }
  }

  if (service === "ELECTRICITY") return pricing.electricity_fee;
  if (service === "EXAM_PIN") return pricing.exam_pin_fee;

  return 0;
}

function customerPrice(
  providerPrice: number,
  service: string,
  product: any,
  quantity: number,
  pricing: PricingSettings,
): number {
  const totalProviderPrice = providerPrice * quantity;
  const adjustment = serviceFee(
    providerPrice,
    service,
    product,
    pricing,
  );

  const totalAdjustment =
    service === "DATA" || service === "AIRTIME"
      ? adjustment * quantity
      : adjustment;

  return money(totalProviderPrice + totalAdjustment);
}

function pricingRuleDescription(
  providerPrice: number,
  service: string,
  product: any,
  pricing: PricingSettings,
): string {
  const fee = serviceFee(providerPrice, service, product, pricing);

  if (service === "AIRTIME") {
    if (fee > 0) return `₦${fee} airtime fee`;
    if (fee < 0) return `₦${Math.abs(fee)} airtime discount`;
    return "Face value; no discount or extra fee";
  }

  if (service === "DATA") {
    return fee > 0
      ? `₦${fee} fee for data above 1.5GB`
      : "No data service fee";
  }

  if (service === "CABLE_TV") {
    const provider = normalizeProvider(
      firstNonEmpty(
        product?.provider_code,
        product?.network,
        product?.provider,
        "",
      ),
    );

    if (provider === "dstv") return `₦${fee} DStv fee`;
    if (provider === "gotv") return `₦${fee} GOtv fee`;
    if (provider === "startimes") {
      return fee > 0
        ? `₦${fee} Startimes fee`
        : "No Startimes fee";
    }
  }

  if (service === "ELECTRICITY") return `₦${fee} electricity fee`;
  if (service === "EXAM_PIN") return `₦${fee} exam PIN fee`;

  return "No additional service fee";
}

/* ---------------- PROVIDER RESPONSE HELPERS ---------------- */

function safeProviderMessage(payload: any): string {
  const d = asObject(payload);
  const nested = asObject(d.data);
  const errorObject = asObject(d.error);
  const nestedErrorObject = asObject(nested.error);

  const msg = firstNonEmpty(
    d.message,
    typeof d.error === "string" ? d.error : undefined,
    errorObject.message,
    errorObject.error,
    nested.message,
    typeof nested.error === "string" ? nested.error : undefined,
    nestedErrorObject.message,
    nestedErrorObject.error,
    d.errors?.[0]?.message,
  );

  if (msg !== undefined && msg !== null) {
    return String(msg).slice(0, 400);
  }

  if (d.error && typeof d.error === "object") {
    try {
      return JSON.stringify(d.error).slice(0, 400);
    } catch {
      // Continue to fallback.
    }
  }

  return "";
}

async function readJson(response: Response): Promise<any> {
  const raw = await response.text();

  if (!raw) return {};

  try {
    return JSON.parse(raw);
  } catch {
    return { message: raw.slice(0, 1000) };
  }
}

function unwrapArray(payload: any): any[] {
  const candidates = [
    payload,
    payload?.services,
    payload?.products,
    payload?.packages,
    payload?.data?.services,
    payload?.data?.products,
    payload?.data?.packages,
    payload?.data?.data,
    payload?.data?.data_bundles,
    payload?.data?.airtime,
    payload?.data?.electricity,
    payload?.data?.cable_tv,
    payload?.data?.cabletv,
    payload?.data?.education,
    payload?.result,
    payload?.result?.data,
    payload?.result?.packages,
  ];

  const output: any[] = [];
  const seenArrays = new Set<any[]>();

  for (const candidate of candidates) {
    if (Array.isArray(candidate) && !seenArrays.has(candidate)) {
      seenArrays.add(candidate);
      output.push(...candidate);
    }
  }

  return output;
}

function isProviderSuccess(payload: any): boolean {
  const d = asObject(payload);
  const nested = asObject(d.data);

  return d.success === true ||
    d.status === true ||
    nested.success === true ||
    String(firstNonEmpty(d.status, nested.status, "")).toLowerCase() ===
      "success";
}

function providerStatus(payload: any): string {
  const d = asObject(payload);
  const n = asObject(d.data);

  return String(
    firstNonEmpty(
      n.status,
      d.status,
      n.transaction_status,
      d.transaction_status,
      "",
    ),
  ).toLowerCase().replace(/[\s-]+/g, "_");
}

function isSuccessStatus(status: string): boolean {
  return [
    "delivered",
    "success",
    "successful",
    "completed",
    "successfully_delivered",
  ].includes(status);
}

function isFailureStatus(status: string): boolean {
  return [
    "failed",
    "failure",
    "declined",
    "rejected",
    "cancelled",
    "canceled",
  ].includes(status);
}

function uniqueWiseSubReference(): string {
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Africa/Lagos",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  }).formatToParts(new Date());

  const get = (type: string) =>
    parts.find((p) => p.type === type)?.value || "";

  const stamp =
    `${get("year")}${get("month")}${get("day")}${get("hour")}${get("minute")}`;

  return `${stamp}${crypto.randomUUID().replace(/-/g, "").slice(0, 12)}`;
}

function randomReference(prefix = "panbill"): string {
  return `${prefix}-${crypto.randomUUID()}`;
}

/* ---------------- WISESUB CONNECTION ---------------- */

async function wiseSubRequest(
  path: string,
  method = "GET",
  body?: Record<string, unknown>,
) {
  if (!WISESUB_API_KEY || !WISESUB_API_SECRET) {
    throw new Error(
      "WISESUB_API_KEY and WISESUB_API_SECRET must be configured in Supabase Function Secrets.",
    );
  }

  const response = await fetch(`${WISESUB_BASE}${path}`, {
    method,
    headers: {
      Authorization: `Bearer ${WISESUB_API_KEY}`,
      "X-API-Secret": WISESUB_API_SECRET,
      "X-Environment": WISESUB_ENVIRONMENT,
      Accept: "application/json",
      ...(method === "POST" ? { "Content-Type": "application/json" } : {}),
    },
    ...(method === "POST" ? { body: JSON.stringify(body || {}) } : {}),
  });

  const data = await readJson(response);
  return { response, data };
}

function wiseServiceType(service: string): string {
  const map: Record<string, string> = {
    AIRTIME: "airtime",
    DATA: "data",
    CABLE_TV: "cabletv",
    ELECTRICITY: "electricity",
    EXAM_PIN: "education",
  };

  const value = map[service];

  if (!value) throw new Error("Unsupported service.");

  return value;
}

function wiseProviderFromRow(row: any): string {
  return String(
    firstNonEmpty(row.provider_code, row.code, row.slug, row.provider, ""),
  );
}

function normalizedCatalogProduct(
  row: any,
  providerCode: string,
  service: string,
  pricing: PricingSettings,
) {
  const p = asObject(row);

  const code = String(
    firstNonEmpty(p.package_code, p.product_code, p.code, p.sku, ""),
  );

  const basePrice = numberValue(
    firstNonEmpty(p.price, p.amount, p.package_price),
  );

  const name = String(
    firstNonEmpty(p.package_name, p.product_name, p.name, p.description, code),
  );

  const product = {
    ...p,
    sku: code || providerCode,
    package_code: code || undefined,
    provider_code: providerCode,
    network: providerCode,
    network_name: providerCode.toUpperCase(),
    name,
    title: name,
    product_name: name,
    service,
  };

  if (!Number.isFinite(basePrice) || basePrice <= 0) return product;

  const fee = serviceFee(basePrice, service, product, pricing);
  const sellingPrice = customerPrice(
    basePrice,
    service,
    product,
    1,
    pricing,
  );

  return {
    ...product,
    provider_price: basePrice,
    service_fee: fee,
    price: sellingPrice,
    selling_price: sellingPrice,
    customer_price: sellingPrice,
    pricing_rule: pricingRuleDescription(
      basePrice,
      service,
      product,
      pricing,
    ),
  };
}

async function getServices(service: string) {
  const result = await wiseSubRequest("/services");

  if (!result.response.ok || !isProviderSuccess(result.data)) {
    throw new Error(
      `WiseSub services request failed (${result.response.status}): ${
        safeProviderMessage(result.data) || "Unexpected response"
      }`,
    );
  }

  const rows = unwrapArray(result.data);
  const wanted = wiseServiceType(service);

  return rows.filter((r: any) => {
    const type = String(
      firstNonEmpty(r.service_type, r.type, r.service, ""),
    ).toLowerCase();

    return type === wanted || type.includes(wanted);
  });
}

async function getCatalog(
  service: string,
  network = "",
  type = "",
  pricing: PricingSettings,
) {
  const serviceType = wiseServiceType(service);
  const servicesResult = await wiseSubRequest("/services");

  if (!servicesResult.response.ok || !isProviderSuccess(servicesResult.data)) {
    throw new Error(
      `WiseSub services request failed (${servicesResult.response.status}): ${
        safeProviderMessage(servicesResult.data) || "Unexpected response"
      }`,
    );
  }

  const allServices = unwrapArray(servicesResult.data);

  const serviceRows = allServices.filter((r: any) => {
    const t = String(
      firstNonEmpty(r.service_type, r.type, r.service, ""),
    ).toLowerCase();

    return t === serviceType || t.includes(serviceType);
  });

  if (serviceRows.length === 0) {
    console.log(
      "WiseSub service catalogue shape",
      Object.keys(asObject(servicesResult.data)),
    );
  }

  if (service === "AIRTIME") {
    return serviceRows.map((row: any) => {
      const provider = wiseProviderFromRow(row);
      const name = String(
        firstNonEmpty(row.provider_name, row.name, provider.toUpperCase()),
      );

      return {
        ...row,
        sku: provider,
        provider_code: provider,
        network: provider,
        network_name: name,
        name: `${name} airtime`,
        title: `${name} airtime`,
        service: "AIRTIME",
      };
    });
  }

  const provider = normalizeProvider(network || type);

  if (!provider) {
    return serviceRows.map((r: any) => ({
      ...r,
      sku: wiseProviderFromRow(r),
      provider_code: wiseProviderFromRow(r),
      name: String(
        firstNonEmpty(r.provider_name, r.name, r.provider_code, "Provider"),
      ),
      title: String(
        firstNonEmpty(r.provider_name, r.name, r.provider_code, "Provider"),
      ),
    }));
  }

  if (service === "ELECTRICITY") {
    const row = serviceRows.find((r: any) =>
      wiseProviderFromRow(r) === provider ||
      String(firstNonEmpty(r.provider_name, r.name, ""))
        .toLowerCase()
        .includes(String(network).toLowerCase())
    );

    if (!row) {
      throw new Error(
        "That electricity provider is not available in the WiseSub catalogue.",
      );
    }

    return [{
      ...row,
      sku: provider,
      provider_code: provider,
      network: provider,
      network_name: String(
        firstNonEmpty(row.provider_name, row.name, provider.toUpperCase()),
      ),
      name: String(firstNonEmpty(row.provider_name, row.name, "Electricity")),
      title: String(firstNonEmpty(row.provider_name, row.name, "Electricity")),
      service: "ELECTRICITY",
    }];
  }

  const path =
    `/packages?service_type=${encodeURIComponent(serviceType)}` +
    `&provider_code=${encodeURIComponent(provider)}`;

  const result = await wiseSubRequest(path);

  if (!result.response.ok || !isProviderSuccess(result.data)) {
    throw new Error(
      `WiseSub package request failed (${result.response.status}): ${
        safeProviderMessage(result.data) || "Could not load packages."
      }`,
    );
  }

  const packages = unwrapArray(result.data);

  let output = packages
    .filter((p: any) => !(
      service === "CABLE_TV" &&
      provider === "startimes" &&
      String(firstNonEmpty(p.package_code, p.code, "")).toLowerCase() ===
        "ewallet"
    ))
    .map((p: any) =>
      normalizedCatalogProduct(p, provider, service, pricing)
    );

  const counts = new Map<string, number>();

  for (const p of output) {
    counts.set(p.sku, (counts.get(p.sku) || 0) + 1);
  }

  output = output.map((p: any) => ({
    ...p,
    ...(p.sku && counts.get(p.sku)! > 1
      ? { ambiguous_package_code: true }
      : {}),
  }));

  return output;
}

/* ---------------- WALLET RPCs ---------------- */

async function finishPurchase(
  userId: string,
  reference: string,
  outcome: "successful" | "failed",
) {
  const { data, error } = await admin.rpc("finish_panbill_vtu_purchase", {
    p_user_id: userId,
    p_reference: reference,
    p_outcome: outcome,
  });

  if (error) {
    throw new Error(`Could not finalize wallet transaction: ${error.message}`);
  }

  const result = asObject(data);

  if (
    outcome === "successful" &&
    result.status !== "successful" &&
    !(
      result.status === "already_finalized" &&
      result.current_status === "successful"
    )
  ) {
    throw new Error(
      `Wallet transaction was not marked successful (${
        String(result.status || "unknown")
      }).`,
    );
  }

  if (
    outcome === "failed" &&
    result.status !== "refunded" &&
    !(
      result.status === "already_finalized" &&
      result.current_status === "failed"
    )
  ) {
    throw new Error(
      `Wallet refund was not confirmed (${
        String(result.status || "unknown")
      }).`,
    );
  }

  return data;
}

async function reservePurchase(
  userId: string,
  amount: number,
  reference: string,
  description: string,
) {
  const { data, error } = await admin.rpc("reserve_panbill_vtu_purchase", {
    p_user_id: userId,
    p_amount: amount,
    p_reference: reference,
    p_description: description,
  });

  if (error) {
    throw new Error(`Could not reserve wallet balance: ${error.message}`);
  }

  const result = asObject(data);

  if (result.status !== "reserved") {
    throw new Error(
      String(
        result.message ||
        result.error ||
        `Wallet reservation was not confirmed (${
          String(result.status || "unknown")
        }).`,
      ),
    );
  }

  return data;
}

/* ---------------- AUTHENTICATION ---------------- */

async function authenticate(request: Request) {
  const authorization = request.headers.get("Authorization") || "";

  if (!authorization.toLowerCase().startsWith("bearer ")) {
    throw new Error("Sign in is required. Please sign in and try again.");
  }

  const token = authorization.slice(7).trim();

  const userClient = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
    auth: { persistSession: false, autoRefreshToken: false },
    global: {
      headers: { Authorization: `Bearer ${token}` },
    },
  });

  const { data, error } = await userClient.auth.getUser(token);

  if (error || !data.user) {
    throw new Error("Your session has expired. Please sign in again.");
  }

  return data.user;
}

/* ---------------- PAYSTACK WALLET FUNDING ---------------- */

async function handlePaystack(
  action: string,
  body: any,
  user: any,
  pricing: PricingSettings,
) {
  if (!PAYSTACK_SECRET_KEY) {
    return respond({
      error: "PAYSTACK_SECRET_KEY is not configured in Supabase Function Secrets.",
    }, 500);
  }

  if (action === "initialize") {
    const amount = numberValue(body.amount);

    if (
      !Number.isFinite(amount) ||
      amount < 100 ||
      amount > 1000000
    ) {
      return respond({
        error: "Enter a funding amount between ₦100 and ₦1,000,000.",
      }, 400);
    }

    const fundingFee = money(
      amount * pricing.wallet_funding_fee_percent / 100,
    );
    const paymentAmount = money(amount + fundingFee);
    const reference = randomReference();

    const fundingRecord = {
      funding_amount: amount,
      funding_fee: fundingFee,
      funding_fee_percent: pricing.wallet_funding_fee_percent,
      payment_amount: paymentAmount,
      pricing_rule: `${pricing.wallet_funding_fee_percent}% wallet funding fee`,
    };

    const { error: insertError } = await admin.from("transactions").insert({
      user_id: user.id,
      type: "wallet_funding",
      amount,
      status: "pending",
      reference,
      description: "Wallet funding",
      provider: "paystack",
      provider_status: "initializing",
      provider_response: fundingRecord,
    });

    if (insertError) {
      throw new Error(
        `Could not create funding transaction: ${insertError.message}`,
      );
    }

    const response = await fetch(
      "https://api.paystack.co/transaction/initialize",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${PAYSTACK_SECRET_KEY}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          email: user.email,
          amount: Math.round(paymentAmount * 100),
          reference,
          callback_url: CALLBACK_URL,
          metadata: {
            user_id: user.id,
            app: "PanBill",
            funding_amount: amount,
            funding_fee: fundingFee,
            payment_amount: paymentAmount,
          },
        }),
      },
    );

    const data = await readJson(response);

    if (
      !response.ok ||
      data.status !== true ||
      !data.data?.authorization_url
    ) {
      await admin.from("transactions").update({
        status: "failed",
        provider_status: "initialize_failed",
        provider_response: {
          ...fundingRecord,
          paystack_error: data,
        },
      }).eq("reference", reference).eq("user_id", user.id);

      return respond({
        error: safeProviderMessage(data) ||
          "Paystack could not start the payment. Please try again.",
      }, 502);
    }

    await admin.from("transactions").update({
      provider_reference: reference,
      provider_status: "initialized",
      provider_response: {
        ...fundingRecord,
        paystack: {
          status: data.status,
          message: data.message,
        },
      },
    }).eq("reference", reference).eq("user_id", user.id);

    return respond({
      success: true,
      reference,
      funding_amount: amount,
      funding_fee: fundingFee,
      funding_fee_percent: pricing.wallet_funding_fee_percent,
      payment_amount: paymentAmount,
      authorization_url: data.data.authorization_url,
      access_code: data.data.access_code,
    });
  }

  if (action === "verify") {
    const reference = String(body.reference || "").trim();

    if (!/^panbill-[A-Za-z0-9-]{10,120}$/.test(reference)) {
      return respond({ error: "Invalid payment reference." }, 400);
    }

    const { data: transaction, error: transactionError } = await admin
      .from("transactions")
      .select("*")
      .eq("reference", reference)
      .eq("user_id", user.id)
      .eq("type", "wallet_funding")
      .maybeSingle();

    if (transactionError) {
      throw new Error(
        `Could not find funding transaction: ${transactionError.message}`,
      );
    }

    if (!transaction) {
      return respond({ error: "Funding transaction was not found." }, 404);
    }

    if (transaction.status === "successful") {
      return respond({
        success: true,
        credited: true,
        already_credited: true,
        reference,
      });
    }

    const response = await fetch(
      `https://api.paystack.co/transaction/verify/${encodeURIComponent(reference)}`,
      {
        headers: {
          Authorization: `Bearer ${PAYSTACK_SECRET_KEY}`,
          Accept: "application/json",
        },
      },
    );

    const data = await readJson(response);

    if (!response.ok || data.status !== true || !data.data) {
      return respond({
        error: safeProviderMessage(data) ||
          "Paystack could not verify this payment yet.",
      }, 502);
    }

    const payment = data.data;
    const paidAmount = numberValue(payment.amount) / 100;
    const fundingRecord = asObject(transaction.provider_response);

    // Use the recorded amount for this transaction. Later admin changes
    // must never alter the amount expected for an older payment.
    const recordedPaymentAmount = numberValue(fundingRecord.payment_amount);
    const expectedPayment = Number.isFinite(recordedPaymentAmount)
      ? recordedPaymentAmount
      : numberValue(transaction.amount);

    if (
      payment.status !== "success" ||
      String(payment.reference) !== reference ||
      String(payment.currency || "").toUpperCase() !== "NGN" ||
      String(payment.metadata?.user_id || "") !== user.id ||
      Math.abs(paidAmount - expectedPayment) > 0.01
    ) {
      return respond({
        error: "Payment is not successful or the payment details do not match this account.",
      }, 400);
    }

    const walletCredit = numberValue(transaction.amount);

    const { data: creditResult, error: creditError } = await admin.rpc(
      "credit_verified_paystack_payment",
      {
        p_reference: reference,
        p_user_id: user.id,
        p_amount: walletCredit,
      },
    );

    if (creditError) {
      throw new Error(
        `Payment verified but wallet credit failed: ${creditError.message}`,
      );
    }

    const result = asObject(creditResult);

    if (result.error || result.success === false) {
      throw new Error(
        String(
          result.message ||
          result.error ||
          "Wallet credit could not be completed.",
        ),
      );
    }

    await admin.from("transactions").update({
      provider_status: "success",
      provider_response: {
        ...fundingRecord,
        verified_payment_amount: paidAmount,
        wallet_credited: walletCredit,
        funding_fee: money(paidAmount - walletCredit),
        paystack_status: payment.status,
      },
    }).eq("reference", reference).eq("user_id", user.id);

    return respond({
      success: true,
      credited: true,
      reference,
      funding_amount_credited: walletCredit,
      funding_fee: money(paidAmount - walletCredit),
      result: creditResult,
    });
  }

  return respond({ error: "Unsupported Paystack action." }, 400);
}

/* ---------------- CATALOGUE ---------------- */

async function handleCatalog(body: any, pricing: PricingSettings) {
  const service = String(body.service || "").toUpperCase();

  if (!allowedServices.has(service)) {
    return respond({ error: "Unsupported service catalogue." }, 400);
  }

  const products = await getCatalog(
    service,
    String(body.network || "").trim(),
    String(body.type || "").trim(),
    pricing,
  );

  return respond({ success: true, products, pricing });
}

/* ---------------- CUSTOMER VALIDATION ---------------- */

async function handleValidate(body: any) {
  const service = String(body.service || "").toUpperCase();

  const provider = normalizeProvider(
    firstNonEmpty(body.biller, body.network, ""),
  );

  const customerNumber = String(
    body.customer_number ||
    body.smartcard_number ||
    body.meter_number ||
    "",
  ).trim();

  if (!["CABLE_TV", "ELECTRICITY"].includes(service)) {
    return respond({
      error: "Validation is available for cable TV and electricity.",
    }, 400);
  }

  if (!customerNumber) {
    return respond({
      error: "Enter the customer or meter number.",
    }, 400);
  }

  if (!provider) {
    return respond({ error: "Select a provider first." }, 400);
  }

  const payload: Record<string, unknown> = {
    service_type: wiseServiceType(service),
    provider_code: provider,
  };

  if (service === "ELECTRICITY") {
    payload.meter_number = customerNumber;
    payload.meter_type = String(
      body.meter_type || body.type || "prepaid",
    ).toLowerCase();
  } else {
    payload.decoder_number = customerNumber;
  }

  const result = await wiseSubRequest("/verify", "POST", payload);

  if (!result.response.ok || !isProviderSuccess(result.data)) {
    return respond({
      success: false,
      error: safeProviderMessage(result.data) ||
        `Customer validation failed (${result.response.status}).`,
      provider_response: result.data,
    }, result.response.status >= 500 ? 502 : 400);
  }

  const data = asObject(result.data.data);

  return respond({
    success: true,
    data,
    customer_name: firstNonEmpty(
      data.customer_name,
      data.name,
      data.customerName,
      null,
    ),
    address: firstNonEmpty(data.address, null),
    provider_response: result.data,
  });
}

/* ---------------- VTU PURCHASE ---------------- */

async function handlePurchase(
  body: any,
  user: any,
  pricing: PricingSettings,
) {
  const service = String(body.service || "").toUpperCase();

  if (!allowedServices.has(service)) {
    return respond({ error: "Unsupported purchase service." }, 400);
  }

  const networkInput = String(
    firstNonEmpty(body.network, body.biller, ""),
  ).trim();

  const provider = normalizeProvider(networkInput);

  const phone = normalizePhone(
    firstNonEmpty(body.phone_number, body.phone, ""),
  );

  const customerNumber = String(
    body.customer_number ||
    body.smartcard_number ||
    body.meter_number ||
    "",
  ).trim();

  const sku = String(
    firstNonEmpty(body.sku, body.package_code, ""),
  ).trim();

  const userAmount = numberValue(body.amount);

  const quantity = Math.max(
    1,
    Math.min(10, Math.floor(numberValue(body.quantity) || 1)),
  );

  if (
    ["AIRTIME", "DATA", "EXAM_PIN"].includes(service) &&
    !/^0\d{10}$/.test(phone)
  ) {
    return respond({
      error: "Enter a valid 11-digit Nigerian phone number beginning with 0.",
    }, 400);
  }

  if (
    ["DATA", "CABLE_TV", "EXAM_PIN"].includes(service) &&
    !sku
  ) {
    return respond({
      error: "Please select a product from the available catalogue.",
    }, 400);
  }

  if (
    ["CABLE_TV", "ELECTRICITY"].includes(service) &&
    !customerNumber
  ) {
    return respond({
      error: service === "CABLE_TV"
        ? "Enter the smartcard/IUC number."
        : "Enter the meter number.",
    }, 400);
  }

  if (!provider) {
    return respond({
      error: "Select a valid network or provider.",
    }, 400);
  }

  let packageRow: any = null;
  let providerAmount = userAmount;
  let productName = `${provider.toUpperCase()} ${service.toLowerCase()}`;

  if (service === "AIRTIME" || service === "ELECTRICITY") {
    if (
      !Number.isFinite(userAmount) ||
      userAmount < 100 ||
      userAmount > 10000000
    ) {
      return respond({
        error: "Enter an amount between ₦100 and ₦10,000,000.",
      }, 400);
    }

    providerAmount = userAmount;

    productName = service === "ELECTRICITY"
      ? `${provider.toUpperCase()} electricity`
      : `${provider.toUpperCase()} airtime`;
  } else {
    const products = await getCatalog(
      service,
      provider,
      String(body.type || ""),
      pricing,
    );

    const matches = products.filter(
      (p: any) => String(p.sku) === sku,
    );

    if (
      matches.length > 1 ||
      matches.some((p: any) => p.ambiguous_package_code)
    ) {
      return respond({
        error: "This package code appears more than once in the provider catalogue. Please choose a different package or contact support.",
      }, 409);
    }

    packageRow = matches[0];

    if (!packageRow) {
      return respond({
        error: "That package is no longer available. Refresh the catalogue and select it again.",
      }, 400);
    }

    providerAmount = numberValue(
      packageRow.provider_price ?? packageRow.price,
    );

    if (!Number.isFinite(providerAmount) || providerAmount <= 0) {
      return respond({
        error: "The selected package has no valid provider price.",
      }, 400);
    }

    productName = String(
      firstNonEmpty(packageRow.name, packageRow.title, sku),
    );
  }

  const providerCharge = money(providerAmount * quantity);

  const customerCharge = customerPrice(
    providerAmount,
    service,
    packageRow,
    quantity,
    pricing,
  );

  if (
    !Number.isFinite(customerCharge) ||
    customerCharge < 1 ||
    customerCharge > 10000000
  ) {
    return respond({
      error: "The selected product or amount has an invalid price.",
    }, 400);
  }

  const totalServiceFee = money(customerCharge - providerCharge);

  const reference = uniqueWiseSubReference();
  const description = `${productName} purchase`;

  await reservePurchase(
    user.id,
    customerCharge,
    reference,
    description,
  );

  const pricingDescription = pricingRuleDescription(
    providerAmount,
    service,
    packageRow,
    pricing,
  );

  const initialRecord = {
    provider: "wisesub",
    provider_reference: reference,
    provider_status: "RESERVED",
    provider_response: {
      service,
      provider_code: provider,
      package_code: packageRow?.package_code || null,
      provider_amount: providerCharge,
      customer_charge: customerCharge,
      service_fee: totalServiceFee,
      pricing_rule: pricingDescription,
      pricing_settings_snapshot: pricing,
      live_mode: WISESUB_ENVIRONMENT === "live",
    },
  };

  const { error: initialUpdateError } = await admin
    .from("transactions")
    .update(initialRecord)
    .eq("reference", reference)
    .eq("user_id", user.id);

  if (initialUpdateError) {
    throw new Error(
      `Wallet was reserved, but the transaction record could not be prepared. Reference: ${reference}. Do not retry this purchase; contact support.`,
    );
  }

  const payload: Record<string, unknown> = {
    service_type: wiseServiceType(service),
    provider_code: provider,
    reference,
  };

  if (service === "AIRTIME") {
    Object.assign(payload, {
      recipient: phone,
      amount: providerAmount,
    });
  } else if (service === "DATA") {
    Object.assign(payload, {
      recipient: phone,
      package_code: sku,
    });
  } else if (service === "ELECTRICITY") {
    Object.assign(payload, {
      meter_number: customerNumber,
      meter_type: String(
        body.meter_type || body.type || "prepaid",
      ).toLowerCase(),
      amount: providerAmount,
      phone: normalizePhone(
        firstNonEmpty(body.phone_number, "08000000000"),
      ),
    });
  } else if (service === "CABLE_TV") {
    Object.assign(payload, {
      package_code: sku,
      decoder_number: customerNumber,
      phone: normalizePhone(
        firstNonEmpty(body.phone_number, "08000000000"),
      ),
      subscription_type: String(
        body.subscription_type || "renewal",
      ).toLowerCase(),
    });
  } else {
    Object.assign(payload, {
      package_code: sku,
      recipient: phone,
      quantity,
    });
  }

  let result: { response: Response; data: any };

  try {
    result = await wiseSubRequest("/purchase", "POST", payload);
  } catch (error) {
    await admin.from("transactions").update({
      provider_status: "UNKNOWN",
      provider_response: {
        ...initialRecord.provider_response,
        error: errorMessage(error).slice(0, 400),
      },
    }).eq("reference", reference).eq("user_id", user.id);

    return respond({
      success: false,
      pending: true,
      reference,
      status: "pending",
      message: "WiseSub's response could not be confirmed. Your transaction remains pending; please do not submit it again.",
    }, 202);
  }

  const { response, data } = result;
  const status = providerStatus(data);

  const providerRef = String(
    firstNonEmpty(
      data?.data?.reference,
      data?.data?.transaction_reference,
      data?.reference,
      reference,
    ),
  );

  const { error: providerSaveError } = await admin
    .from("transactions")
    .update({
      provider: "wisesub",
      provider_reference: providerRef,
      provider_status: status ||
        (response.ok ? "PENDING_PROVIDER_QUERY" : `HTTP_${response.status}`),
      provider_response: {
        request: payload,
        response: data,
        provider_amount: providerCharge,
        customer_charge: customerCharge,
        service_fee: totalServiceFee,
        pricing_rule: pricingDescription,
        pricing_settings_snapshot: pricing,
        live_mode: WISESUB_ENVIRONMENT === "live",
      },
    })
    .eq("reference", reference)
    .eq("user_id", user.id);

  if (providerSaveError) {
    return respond({
      success: false,
      pending: true,
      status: "pending",
      reference,
      message: "WiseSub responded, but PanBill could not safely save the provider result. Your wallet reservation remains pending. Contact support with this reference; do not retry.",
    }, 202);
  }

  if (response.ok && isSuccessStatus(status)) {
    await finishPurchase(user.id, reference, "successful");

    return respond({
      success: true,
      status: "successful",
      reference,
      amount: customerCharge,
      provider_amount: providerCharge,
      service_fee: totalServiceFee,
      data: data.data || data,
      message: "Purchase completed successfully.",
      live_mode: WISESUB_ENVIRONMENT === "live",
    });
  }

  if (isFailureStatus(status)) {
    await finishPurchase(user.id, reference, "failed");

    return respond({
      success: false,
      status: "failed",
      reference,
      message: safeProviderMessage(data) ||
        "WiseSub confirmed that this purchase failed. Wallet refund processed.",
    }, 400);
  }

  return respond({
    success: false,
    pending: true,
    status: "pending",
    reference,
    message: safeProviderMessage(data) ||
      "WiseSub has not confirmed a final result. Your transaction remains pending; check its status before trying again.",
    live_mode: WISESUB_ENVIRONMENT === "live",
  }, 202);
}

/* ---------------- PURCHASE STATUS ---------------- */

async function handleStatus(body: any, user: any) {
  const reference = String(body.reference || "").trim();

  if (!reference) {
    return respond({ error: "Enter a transaction reference." }, 400);
  }

  const { data: transaction, error } = await admin
    .from("transactions")
    .select("*")
    .eq("reference", reference)
    .eq("user_id", user.id)
    .eq("type", "vtu_purchase")
    .maybeSingle();

  if (error) {
    throw new Error(`Could not load transaction: ${error.message}`);
  }

  if (!transaction) {
    return respond({
      error: "Purchase transaction was not found.",
    }, 404);
  }

  if (transaction.status === "successful") {
    return respond({
      success: true,
      status: "successful",
      reference,
      message: "Purchase completed successfully.",
    });
  }

  if (transaction.status === "failed") {
    return respond({
      success: false,
      status: "failed",
      reference,
      message: "This purchase failed. If it was charged, the wallet refund is recorded.",
    });
  }

  let result: { response: Response; data: any };

  try {
    result = await wiseSubRequest(
      `/status?reference=${encodeURIComponent(reference)}`,
    );
  } catch {
    return respond({
      success: false,
      pending: true,
      status: "pending",
      reference,
      message: "WiseSub status could not be checked. Your transaction remains pending.",
    }, 202);
  }

  if (!result.response.ok) {
    return respond({
      success: false,
      pending: true,
      status: "pending",
      reference,
      message: `WiseSub status check returned HTTP ${result.response.status}. Your transaction remains pending.`,
    }, 202);
  }

  const data = result.data;
  const status = providerStatus(data);
  const previousProviderResponse = asObject(
    transaction.provider_response,
  );

  const { error: statusSaveError } = await admin
    .from("transactions")
    .update({
      provider: "wisesub",
      provider_status: status.toUpperCase() ||
        `HTTP_${result.response.status}`,
      provider_response: {
        ...previousProviderResponse,
        latest_status_response: data,
        latest_status_checked_at: new Date().toISOString(),
      },
    })
    .eq("reference", reference)
    .eq("user_id", user.id);

  if (statusSaveError) {
    return respond({
      success: false,
      pending: true,
      status: "pending",
      reference,
      message: "WiseSub returned a status, but PanBill could not save it. The transaction remains pending; contact support with this reference.",
    }, 202);
  }

  if (isSuccessStatus(status)) {
    await finishPurchase(user.id, reference, "successful");

    const purchaseData = asObject(
      previousProviderResponse.response,
    );

    return respond({
      success: true,
      status: "successful",
      reference,
      data: purchaseData.data || purchaseData || data.data || data,
      latest_status: data,
      message: "WiseSub confirms the purchase was delivered.",
    });
  }

  if (isFailureStatus(status)) {
    await finishPurchase(user.id, reference, "failed");

    return respond({
      success: false,
      status: "failed",
      reference,
      message: safeProviderMessage(data) ||
        "WiseSub confirms failure; wallet refund processed.",
    });
  }

  return respond({
    success: false,
    pending: true,
    status: "pending",
    reference,
    data: data.data || data,
    message: "WiseSub has not confirmed a safe final outcome. Your transaction remains pending.",
  }, 202);
}

/* ---------------- MAIN SERVER ---------------- */

Deno.serve(async (request: Request) => {
  if (request.method === "OPTIONS") {
    return new Response("ok", { headers: corsHeaders });
  }

  try {
    if (
      !SUPABASE_URL ||
      !SUPABASE_ANON_KEY ||
      !SUPABASE_SERVICE_ROLE_KEY
    ) {
      return respond({
        error: "Supabase function environment is missing required configuration.",
      }, 500);
    }

    if (request.method === "GET") {
      return respond({
        success: true,
        service: "PanBill WiseSub API",
        status: "working",
        environment: WISESUB_ENVIRONMENT,
      });
    }

    if (request.method !== "POST") {
      return respond({ error: "Method not allowed." }, 405);
    }

    const user = await authenticate(request);
    const body = asObject(await request.json());
    const action = String(body.action || "").trim().toLowerCase();

    /*
     * Load the latest admin pricing for every authenticated request.
     * If the pricing table cannot be read, purchases and funding fail
     * safely instead of silently charging an outdated price.
     */
    const pricing = await getPricingSettings();

    if (action === "initialize" || action === "verify") {
      return await handlePaystack(action, body, user, pricing);
    }

    if (action === "catalog") {
      return await handleCatalog(body, pricing);
    }

    if (action === "validate") {
      return await handleValidate(body);
    }

    if (action === "purchase") {
      return await handlePurchase(body, user, pricing);
    }

    if (action === "status") {
      return await handleStatus(body, user);
    }

    return respond({ error: "Unknown action." }, 400);
  } catch (error) {
    const detail = errorMessage(error);
    console.error("PanBill WiseSub backend error:", detail);

    return respond({
      error: detail || "Unexpected PanBill backend error.",
      diagnostic: "super-responder",
    }, 500);
  }
});
