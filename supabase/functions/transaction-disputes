import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

const SUPABASE_URL = Deno.env.get("SUPABASE_URL") ?? "";
const SUPABASE_ANON_KEY = Deno.env.get("SUPABASE_ANON_KEY") ?? "";
const SUPABASE_SERVICE_ROLE_KEY =
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY") ?? "";

const db = createClient(
  SUPABASE_URL,
  SUPABASE_SERVICE_ROLE_KEY,
  {
    auth: {
      persistSession: false,
      autoRefreshToken: false,
    },
  },
);

function respond(body: unknown, status = 200) {
  return new Response(JSON.stringify(body), {
    status,
    headers: {
      ...corsHeaders,
      "Content-Type": "application/json",
    },
  });
}

function clean(value: unknown, max = 1000): string {
  return typeof value === "string"
    ? value.trim().slice(0, max)
    : "";
}

async function authenticate(req: Request) {
  const authorization =
    req.headers.get("Authorization") ?? "";

  if (!authorization.startsWith("Bearer ")) {
    throw new Error("Authentication required.");
  }

  const client = createClient(
    SUPABASE_URL,
    SUPABASE_ANON_KEY,
    {
      auth: {
        persistSession: false,
        autoRefreshToken: false,
      },
      global: {
        headers: {
          Authorization: authorization,
        },
      },
    },
  );

  const { data, error } = await client.auth.getUser();

  if (error || !data.user) {
    throw new Error("Invalid or expired session.");
  }

  return data.user;
}

async function requireAdmin(userId: string) {
  const { data, error } = await db
    .from("panbill_admins")
    .select("user_id,role")
    .eq("user_id", userId)
    .eq("role", "admin")
    .maybeSingle();

  if (error) throw error;

  if (!data) {
    throw new Error("Admin access required.");
  }
}

/* =========================================
   CUSTOMER: SUBMIT DISPUTE
========================================= */

async function submitDispute(body: any, user: any) {
  const reference = clean(
    body.transaction_reference,
    150,
  );

  const reason = clean(body.reason, 120);

  const description = clean(
    body.description,
    2000,
  );

  if (!reference || !reason || description.length < 10) {
    throw new Error(
      "Transaction reference, reason, and a description of at least 10 characters are required.",
    );
  }

  // Verify that this transaction belongs to the customer.
  const { data: transaction, error: txError } =
    await db
      .from("transactions")
      .select(
        "reference,user_id,type,status,amount,description,created_at",
      )
      .eq("reference", reference)
      .eq("user_id", user.id)
      .maybeSingle();

  if (txError) throw txError;

  if (!transaction) {
    throw new Error(
      "Transaction not found for your account.",
    );
  }

  // Create dispute.
  const { data: dispute, error } = await db
    .from("panbill_transaction_disputes")
    .insert({
      user_id: user.id,
      transaction_reference: reference,
      reason,
      description,
    })
    .select("*")
    .single();

  if (error) {
    if (error.code === "23505") {
      throw new Error(
        "A dispute already exists for this transaction.",
      );
    }

    throw error;
  }

  // Add initial history entry.
  await db
    .from("panbill_dispute_updates")
    .insert({
      dispute_id: dispute.id,
      actor_user_id: user.id,
      actor_type: "customer",
      new_status: "open",
      message: "Dispute submitted.",
      is_internal: false,
    });

  return {
    dispute,
  };
}

/* =========================================
   CUSTOMER: LIST DISPUTES
========================================= */

async function myDisputes(user: any) {
  const { data, error } = await db
    .from("panbill_transaction_disputes")
    .select(
      "id,dispute_reference,transaction_reference,reason,description,status,admin_response,created_at,updated_at,resolved_at",
    )
    .eq("user_id", user.id)
    .order("created_at", {
      ascending: false,
    });

  if (error) throw error;

  return {
    disputes: data ?? [],
  };
}

/* =========================================
   CUSTOMER: DISPUTE DETAILS
========================================= */

async function disputeDetails(body: any, user: any) {
  const id = clean(body.dispute_id, 100);

  if (!id) {
    throw new Error("dispute_id is required.");
  }

  const { data: dispute, error } = await db
    .from("panbill_transaction_disputes")
    .select("*")
    .eq("id", id)
    .eq("user_id", user.id)
    .maybeSingle();

  if (error) throw error;

  if (!dispute) {
    throw new Error("Dispute not found.");
  }

  const { data: updates, error: updateError } =
    await db
      .from("panbill_dispute_updates")
      .select(
        "id,actor_type,new_status,message,created_at",
      )
      .eq("dispute_id", id)
      .eq("is_internal", false)
      .order("created_at", {
        ascending: true,
      });

  if (updateError) throw updateError;

  return {
    dispute,
    updates: updates ?? [],
  };
}

/* =========================================
   ADMIN: LIST DISPUTES
========================================= */

async function adminList(body: any, user: any) {
  await requireAdmin(user.id);

  const status = clean(body.status, 30);

  let query = db
    .from("panbill_transaction_disputes")
    .select("*")
    .order("created_at", {
      ascending: false,
    })
    .limit(500);

  if (status && status !== "all") {
    query = query.eq("status", status);
  }

  const { data, error } = await query;

  if (error) throw error;

  return {
    disputes: data ?? [],
  };
}

/* =========================================
   ADMIN: UPDATE DISPUTE
========================================= */

async function adminUpdate(body: any, user: any) {
  await requireAdmin(user.id);

  const id = clean(body.dispute_id, 100);

  const status = clean(body.status, 30);

  const response = clean(
    body.admin_response,
    2000,
  );

  const internalNote = clean(
    body.internal_note,
    2000,
  );

  const validStatuses = [
    "open",
    "under_review",
    "resolved",
    "rejected",
  ];

  if (
    !id ||
    !validStatuses.includes(status)
  ) {
    throw new Error(
      "Valid dispute_id and status are required.",
    );
  }

  const { data: old, error: oldError } =
    await db
      .from("panbill_transaction_disputes")
      .select("id,status")
      .eq("id", id)
      .maybeSingle();

  if (oldError) throw oldError;

  if (!old) {
    throw new Error("Dispute not found.");
  }

  const patch: Record<string, unknown> = {
    status,
    assigned_admin: user.id,
    updated_at: new Date().toISOString(),
  };

  if (response) {
    patch.admin_response = response;
  }

  if (
    status === "resolved" ||
    status === "rejected"
  ) {
    patch.resolved_at =
      new Date().toISOString();
  } else {
    patch.resolved_at = null;
  }

  const { data, error } = await db
    .from("panbill_transaction_disputes")
    .update(patch)
    .eq("id", id)
    .select("*")
    .single();

  if (error) throw error;

  const message =
    response ||
    internalNote ||
    `Status changed to ${status}.`;

  await db
    .from("panbill_dispute_updates")
    .insert({
      dispute_id: id,
      actor_user_id: user.id,
      actor_type: "admin",
      old_status: old.status,
      new_status: status,
      message,
      is_internal: !response && !!internalNote,
    });

  return {
    dispute: data,
  };
}

/* =========================================
   EDGE FUNCTION ROUTER
========================================= */

Deno.serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", {
      headers: corsHeaders,
    });
  }

  if (req.method !== "POST") {
    return respond(
      {
        success: false,
        error: "Method not allowed.",
      },
      405,
    );
  }

  try {
    if (
      !SUPABASE_URL ||
      !SUPABASE_ANON_KEY ||
      !SUPABASE_SERVICE_ROLE_KEY
    ) {
      return respond(
        {
          success: false,
          error: "Function secrets are not configured.",
        },
        500,
      );
    }

    const user = await authenticate(req);

    const body = await req.json().catch(
      () => ({}),
    );

    const action = clean(
      body.action,
      50,
    ).toLowerCase();

    let result: unknown;

    switch (action) {
      case "submit_dispute":
        result = await submitDispute(
          body,
          user,
        );
        break;

      case "my_disputes":
        result = await myDisputes(user);
        break;

      case "dispute_details":
        result = await disputeDetails(
          body,
          user,
        );
        break;

      case "admin_disputes":
        result = await adminList(
          body,
          user,
        );
        break;

      case "admin_update_dispute":
        result = await adminUpdate(
          body,
          user,
        );
        break;

      default:
        return respond(
          {
            success: false,
            error: "Unknown dispute action.",
          },
          400,
        );
    }

    return respond({
      success: true,
      ...(result as Record<string, unknown>),
    });
  } catch (err) {
    const message =
      err instanceof Error
        ? err.message
        : "Request failed.";

    const status =
      /admin access required/i.test(message)
        ? 403
        : /authentication|session/i.test(message)
          ? 401
          : 400;

    return respond(
      {
        success: false,
        error: message,
      },
      status,
    );
  }
});
